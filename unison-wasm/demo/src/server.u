  --       Response.ok (toJson {quantity = qty, price = price})
  --     _ ->
  --       Response.notFound "Not found"

  printLine "Note: Full HTTP server requires UCM HTTP abilities."
  printLine "For the demo, we use the Node.js server with the same WASM module."
