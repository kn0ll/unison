-- server.u
-- HTTP server that runs the same pricing logic natively
--
-- This demonstrates that the SAME Unison code runs on:
-- - Browser (compiled to WASM)
-- - Server (native Unison runtime)

-- For now, this is a placeholder. In a full implementation,
-- this would use UCM's HTTP server abilities.

server.main : '{IO, Exception} ()
server.main = do
  printLine "Starting Unison pricing server on http://localhost:8080"
  printLine "Using the SAME calculatePrice function as the browser!"
  printLine ""
  printLine "Endpoints:"
  printLine "  GET /api/price?qty=5  → returns {quantity: 5, price: 4500}"
  printLine ""

