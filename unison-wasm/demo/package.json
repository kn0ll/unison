{
  "name": "unison-wasm-demo",
  "version": "0.1.0",
  "description": "Unison WASM Demo - Price Calculator showing one-program fullstack",
  "type": "module",
  "scripts": {
    "build:wasm": "bash build-wasm.sh",
    "build:ts": "tsc",
    "build": "npm run build:wasm && npm run build:ts",
    "serve:static": "npx serve . -l 3000",
    "server": "node dist/server.js",
    "dev": "npm run build && npm run server",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@unison/wasm-runtime": "file:../js"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "serve": "^14.2.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "unison",
    "wasm",
    "webassembly",
    "fullstack",
    "demo"
  ],
  "author": "Unison Computing",
  "license": "MIT"
}

