{
  "name": "@unison/wasm-runtime",
  "version": "0.1.0",
  "description": "JavaScript runtime for Unison WASM backend",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./abi-constants": "./dist/abi-constants.js",
    "./wasm-alloc": "./dist/wasm-alloc.js",
    "./wasm-debug": "./dist/wasm-debug.js",
    "./errors": "./dist/errors.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test 'dist/tests/**/*.test.js'",
    "test:watch": "tsc && node --test --watch 'dist/tests/**/*.test.js'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.3.0",
    "wabt": "^1.0.36"
  },
  "keywords": [
    "unison",
    "wasm",
    "webassembly",
    "runtime"
  ],
  "license": "MIT"
}
